#!/bin/bash
set -Eeuo pipefail

exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

PS4='+ $${BASH_SOURCE}:$${LINENO}:$${FUNCNAME[0]:-main}(): '
set -x

trap 'rc=$?;
  echo "ERROR: exit=$rc line=$LINENO cmd=$BASH_COMMAND" >&2
  exit $rc
' ERR

# Create swap early
if ! swapon --show | awk '{print $1}' | grep -qx /swapfile; then
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi





# Install Docker (Amazon Linux 2023)
yum update -y
yum install -y docker git
systemctl enable --now docker

yum install -y nodejs npm git # Install NodeJS

# Add ec2-user to docker group
usermod -aG docker ec2-user

# Install Docker Compose plugin for ec2-user
su - ec2-user -c 'mkdir -p ~/.docker/cli-plugins'
su - ec2-user -c 'curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m) -o ~/.docker/cli-plugins/docker-compose'
su - ec2-user -c 'chmod +x ~/.docker/cli-plugins/docker-compose'

# Fetch Repetika and write .env
su - ec2-user -c 'cd ~ && git clone https://github.com/Romain-Ryckebusch/Repetika.git || true'
su - ec2-user -c 'cd ~/Repetika && git pull'

cat > /home/ec2-user/Repetika/.env <<EOF
MONGO_DB=repetika
MONGO_URL=mongodb://mongodb:27017/repetika
MONGO_URI=mongodb://mongodb:27017/
SECRET_KEY=${secret_key}
POSTGRES_DB=authdb
POSTGRES_USER=authuser
POSTGRES_PASSWORD=${postgres_password}
EOF
chown ec2-user:ec2-user /home/ec2-user/Repetika/.env
chmod 600 /home/ec2-user/Repetika/.env


# Install Compose system-wide
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m) \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Install up-to-date Buildx system-wide
ARCH="$(uname -m)"
TMP="/tmp/docker-buildx"
rm -f "$TMP"

if [ "$ARCH" = "x86_64" ]; then
  URL="https://github.com/docker/buildx/releases/download/v0.30.1/buildx-v0.30.1.linux-amd64"
  SHA="c37114fcd034025ec68e224657c8a5a850df472ded3ddcbca75ad3a7ebb9710d"
elif [ "$ARCH" = "aarch64" ]; then
  URL="https://github.com/docker/buildx/releases/download/v0.30.1/buildx-v0.30.1.linux-arm64"
  SHA="31d012d52d6df68aef4b55db62330967b562811f0de30cdfaa4505f314797c76"
else
  echo "Unsupported arch: $ARCH"
  exit 1
fi

curl -fsSL "$URL" -o "$TMP"
echo "$SHA  $TMP" | sha256sum -c -

mkdir -p /usr/local/lib/docker/cli-plugins
install -m 0755 "$TMP" /usr/local/lib/docker/cli-plugins/docker-buildx

# Remove other copies to avoid ambiguity
rm -f /usr/libexec/docker/cli-plugins/docker-buildx /usr/lib/docker/cli-plugins/docker-buildx 2>/dev/null || true
rm -f /home/ec2-user/.docker/cli-plugins/docker-buildx 2>/dev/null || true


# Install for ec2 user
mkdir -p /home/ec2-user/.docker/cli-plugins
install -m 0755 "$TMP" /home/ec2-user/.docker/cli-plugins/docker-buildx
chown -R ec2-user:ec2-user /home/ec2-user/.docker




# Start Repetika stack
su - ec2-user -c 'cd ~/Repetika && docker compose up --build -d'



echo "Docker compose up completed"



export NODE_OPTIONS="--max-old-space-size=768"

echo "Swapfile created and NODE_OPTIONS set"

# Needed for tunneling with `npx expo start --tunnel`
sudo npm i -g @expo/ngrok  # https://docs.expo.dev/more/expo-cli/

# Install mobile app dependencies
sudo -u ec2-user bash -lc '
  cd ~/Repetika/apps/mobile/RepetikaApp
  npm ci --omit=dev --no-audit --no-fund
'


echo "npm install completed"









# Make it restart on reboot (systemd)
cat > /etc/systemd/system/repetika.service <<'UNIT'
[Unit]
Description=Repetika (docker compose)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ec2-user
WorkingDirectory=/home/ec2-user/Repetika
ExecStart=/usr/bin/bash -lc 'docker compose up --quiet-pull -d'
ExecStop=/usr/bin/bash -lc 'docker compose down'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
UNIT




# Create a systemd service to keep Expo running
cat >/etc/systemd/system/repetika-expo.service <<'EOF'
[Unit]
Description=Repetika Expo dev server (tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/Repetika/apps/mobile/RepetikaApp
Environment=CI=1
ExecStart=/usr/bin/env npx expo start --tunnel
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF



systemctl daemon-reload
systemctl enable repetika.service
systemctl enable --now repetika-expo.service
